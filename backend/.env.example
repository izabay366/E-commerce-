# ============================================================
# Muhanga Marketplace - Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ============================================================

# Server
PORT=5000

# CORS — set this to your frontend domain in production
ALLOWED_ORIGIN=http://localhost:3000

# ─── DATABASE ──────────────────────────────────────────────
# OPTION A (Production — Render + Neon):
#   Set DATABASE_URL only. The DB_* vars below are ignored when DATABASE_URL is set.
#   Get this from your Neon dashboard → Connection Details → Connection string
# DATABASE_URL=postgresql://username:password@ep-xxx.neon.tech/muhanga_market?sslmode=require

# OPTION B (Local development):
#   Leave DATABASE_URL blank/unset and fill in the individual vars below.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=muhanga_market
DB_USER=postgres
DB_PASSWORD=your_db_password_here


# JWT
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=7d
