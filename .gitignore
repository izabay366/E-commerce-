# ============================================================
# Muhanga Marketplace — Root .gitignore
# ============================================================

# Dependencies
node_modules/

# Environment variables (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
build/
dist/

# Uploaded product images (ephemeral on Render — use Cloudinary in production)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# macOS
.DS_Store

# IDE
.idea/
.vscode/
